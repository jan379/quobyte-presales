# Let's first bench the network, then the storage

# Network benchmark. Needs elbencho deployed && started on all hosts that participate
## Clients send data
label=arg="Bandwidth, all clients send 10M blocks and receive a tiny 1 bit."
resfile={{ ansible_env.HOME }}/benchmarks/results/elbencho-netbench.txt
netbench=1
serversfile={{ ansible_env.HOME }}/benchmarks/elbencho-firstdataserver.list
clientsfile={{ ansible_env.HOME }}/benchmarks/elbencho-firstclient.list
block=10m
respsize=1
threads=32
size=100g
timelimit=60
lat=1
