# Let's first bench the network, then the storage

# Network benchmark. Needs elbencho deployed && started on all hosts that participate
## Clients send data
label=arg="One server sends data to another (backend throughput)"
resfile={{ bench_dir }}/results/elbencho-netbench_s2s.txt
netbench=1
serversfile={{ hosts_dir }}/elbencho-firstdataserver.list
clientsfile={{ hosts_dir }}/elbencho-seconddataserver.list
block=10m
respsize=1
threads=32
size=100g
timelimit=60
lat=1
