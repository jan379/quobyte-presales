# Let's first bench the network, then the storage

# Network benchmark. Needs elbencho deployed && started on all hosts that participate
## Clients send data
label=arg="All clients send data to all servers (parallel throughput)"
resfile={{ bench_dir }}/results/elbencho-netbench.txt
netbench=1
serversfile={{ hosts_dir }}/elbencho-dataserver.list
clientsfile={{ hosts_dir }}/elbencho-clients.list
block=10m
respsize=1
threads=32
size=100g
timelimit=60
lat=1
