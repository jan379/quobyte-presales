# Create large files in parallel.
# You can benchmark data performance/ throughput using this test.
# You can observe differences for different stripe widths.
# Example call:
# elbencho -c parallel_throughput.elbencho /quobyte/elbencho

hostsfile={{ hosts_dir }}/elbencho-clients.list
resfile={{ bench_dir }}/results/elbencho-parallel_throughput.txt

# Needed capacity will be clients * threads * files * size
size=300M	# A broad distribution across devices even on small systems
block=8M	# A convenient block size
write=1		# Files are only created if "write=1"
read=1		# Let's collect read performance
threads=8	# Do parallel requests from each client
mkdirs=1	# Create directories if necessary
delfiles=1	# Delete files
deldirs=1	# Delete directories
dirs=1		# Number of directories per worker thread
files=400	# Number of files to create
iodepth=1	# >1 enables async I/O
trunc=1		# Truncate files if they are re-written.
cpu=1		# We are interested in client CPUs as upper boundary
lat=1		# Latencies can explain a lot
